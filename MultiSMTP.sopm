            </ForeignKey>
            <ForeignKey ForeignTable="valid">
                <Reference Local="valid_id" Foreign="id" />
            </ForeignKey>
            <ForeignKey ForeignTable="oidc_functional_accounts">
                <Reference Local="oauth2_functional_account_id" Foreign="id" />
            </ForeignKey>
        </TableCreate>
