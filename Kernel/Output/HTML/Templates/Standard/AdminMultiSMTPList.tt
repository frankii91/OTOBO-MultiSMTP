<div class="MainBox ARIARoleMain LayoutFixedSidebar SidebarFirst">
    <h1 class="InvisibleText">[% Translate("SMTP Management") | html %]</h1>
    [% BreadcrumbPath = [ { Name => Translate('SMTP Management'), Link => Env("Action") } ] %]
    [% INCLUDE "Breadcrumb.tt" Path = BreadcrumbPath %]
    <div class="Clear"></div>
    <div class="SidebarColumn">
        <div class="WidgetSimple">
            <div class="Header"><h2>[% Translate("Actions") | html %]</h2></div>
            <div class="Content">
                <ul class="ActionList">
                    <li><a href="[% Env("Baselink") %]Action=[% Env("Action") %];Subaction=Add" class="CallForAction Fullsize Center"><span><i class="fa fa-plus-square"></i>[% Translate("Add SMTP") | html %]</span></a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="ContentColumn">
        <div class="WidgetSimple">
            <div class="Header"><h2>[% Translate("List") | html %]</h2></div>
            <div class="Content">
                <table class="DataTable" id="SMTP">
                    <thead>
                        <tr>
                            <th>[% Translate("ID") | html %]</th>
                            <th>[% Translate("Host") | html %]</th>
                            <th>[% Translate("User") | html %]</th>
                            <th>[% Translate("Port") | html %]</th>
                            <th>[% Translate("Emails") | html %]</th>
                            <th>[% Translate("Type") | html %]</th>
                            <th>[% Translate("Authentication") | html %]</th>
                            <th>[% Translate("Validity") | html %]</th>
                            <th>[% Translate("Date") | html %]</th>
                            <th>[% Translate("Creator") | html %]</th>
                            <th>[% Translate("Comment") | html %]</th>
                            <th>[% Translate("Delete") | html %]</th>
                        </tr>
                    </thead>
                    <tbody>
[% RenderBlockStart("NoSMTPFound") %]
                        <tr><td colspan="12">[% Translate("No matches found.") | html %]</td></tr>
[% RenderBlockEnd("NoSMTPFound") %]
[% RenderBlockStart("SMTPRow") %]
                        <tr>
                            <td><a href="[% Env("Baselink") %]Action=AdminMultiSMTP;Subaction=Edit;ID=[% Data.ID | uri %]">[% Data.ID | html %]</a></td>
                            <td><a class="AsBlock" href="[% Env("Baselink") %]Action=AdminMultiSMTP;Subaction=Edit;ID=[% Data.ID | uri %]">[% Data.Host | html %]</a></td>
                            <td>[% Data.User | html %]</td>
                            <td>[% Data.Port | html %]</td>
                            <td>[% Data.EmailString | html %]</td>
                            <td>[% Data.Type | html %]</td>
                            <td>[% Data.AuthString | html %]</td>
                            <td>[% Translate(Data.Valid) | html %]</td>
                            <td>[% Data.CreateTime | Localize("TimeShort") %]</td>
                            <td>[% Data.Creator | html %]</td>
                            <td title="[% Data.Comments | html %]">[% Data.Comments | truncate(20) | html %]</td>
                            <td class="Center">
                                <form action="[% Env("CGIHandle") %]" method="post" class="DeleteSMTP">
                                    <input type="hidden" name="Action" value="[% Env("Action") %]"/>
                                    <input type="hidden" name="Subaction" value="Delete"/>
                                    <input type="hidden" name="ID" value="[% Data.ID | html %]"/>
                                    <input type="hidden" name="ChallengeToken" value="[% Env("UserChallengeToken") | html %]"/>
                                    <button type="submit" class="CallForAction"><span>[% Translate("Delete") | html %]</span></button>
                                </form>
                            </td>
                        </tr>
[% RenderBlockEnd("SMTPRow") %]
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="Clear"></div>
</div>
<div class="Hidden" id="DeleteSMTPDialogContainer">
    <div class="InnerContent GenericInterfaceDialog">
        <p class="Center Spacing">[% Translate("Do you really want to delete this SMTP account?") | html %]</p>
        <div class="SpacingTop"></div>
    </div>
</div>
[% WRAPPER JSOnDocumentComplete %]
<script type="text/javascript">
    $('form.DeleteSMTP').on('submit', function (Event) {
        var Form = this;
        Event.preventDefault();
        Core.UI.Dialog.ShowContentDialog(
            $('#DeleteSMTPDialogContainer'),
            [% Translate("Delete account") | JSON %],
            '240px',
            'Center',
            true,
            [
                {
                    Class: 'Primary',
                    Label: Core.Language.Translate('Confirm'),
                    Function: function () {
                        Core.UI.Dialog.CloseDialog($('#DialogButton1'));
                        Form.submit();
                    }
                },
                {
                    Label: Core.Language.Translate('Cancel'),
                    Type: 'Close'
                }
            ]
        );
    });
</script>
[% END %]
