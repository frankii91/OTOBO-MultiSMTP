<div class="MainBox ARIARoleMain LayoutFixedSidebar SidebarFirst">
    <h1 class="InvisibleText">[% Translate("SMTP Management") | html %]</h1>
    [% BreadcrumbPath = [ { Name => Translate('SMTP Management'), Link => Env("Action") },
        { Name => Translate('Add/Change SMTP') } ] %]
    [% INCLUDE "Breadcrumb.tt" Path = BreadcrumbPath %]
    <div class="Clear"></div>
    <div class="SidebarColumn">
        <div class="WidgetSimple">
            <div class="Header">
                <h2>[% Translate("Actions") | html %]</h2>
            </div>
            <div class="Content">
                <ul class="ActionList">
                    <li>
                        <a href="[% Env("Baselink") %]Action=[% Env("Action") %]" class="CallForAction Fullsize Center"><span><i class="fa fa-caret-left"></i>[% Translate("Go to overview") | html %]</span></a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="ContentColumn">
        <div class="WidgetSimple">
            <div class="Header">
                <h2>[% Translate("Add/Change SMTP") | html %]</h2>
            </div>
            <div class="Content">
                <form action="[% Env("CGIHandle") %]" method="post" class="Validate">
                    <input type="hidden" name="Action" value="[% Env("Action") %]"/>
                    <input type="hidden" name="Subaction" value="[% Data.Subaction | html %]"/>
                    <input type="hidden" name="ID" value="[% Data.ID | html %]"/>
                    <input type="hidden" name="ChallengeToken" value="[% Env("UserChallengeToken") | html %]"/>

                    <fieldset class="TableLike">
                        <label for="Host" class="Mandatory"><span class="Marker">*</span>[% Translate("Host") | html %]:</label>
                        <div class="Field">
                            <input type="text" id="Host" name="Host" value="[% Data.Host | html %]" class="W75pc Validate_Required [% Data.HostInvalid | html %]" maxlength="250"/>
                            <div id="HostServerError" class="TooltipErrorMessage"><p>[% Translate("This field is required.") | html %]</p></div>
                        </div><div class="Clear"></div>

                        <label for="Port" class="Mandatory"><span class="Marker">*</span>[% Translate("Port") | html %]:</label>
                        <div class="Field">
                            <input type="text" id="Port" name="Port" value="[% Data.Port | html %]" class="W10pc Validate_Required [% Data.PortInvalid | html %]" maxlength="5"/>
                            <div id="PortServerError" class="TooltipErrorMessage"><p>[% Translate("Please enter a valid port.") | html %]</p></div>
                        </div><div class="Clear"></div>

                        <label for="Type" class="Mandatory"><span class="Marker">*</span>[% Translate("Type") | html %]:</label>
                        <div class="Field">
                            [% Data.TypeSelect %]
                            <div id="TypeServerError" class="TooltipErrorMessage"><p>[% Translate("Please select a valid transport.") | html %]</p></div>
                        </div><div class="Clear"></div>

                        <label for="AuthMethod" class="Mandatory"><span class="Marker">*</span>[% Translate("Authentication") | html %]:</label>
                        <div class="Field">
                            [% Data.AuthMethodSelect %]
                            <div id="AuthMethodServerError" class="TooltipErrorMessage"><p>[% Translate("Please select a valid authentication method.") | html %]</p></div>
                        </div><div class="Clear"></div>

                        <label for="User" id="UserLabel" class="Mandatory"><span id="UserMarker" class="Marker">*</span>[% Translate("User") | html %]:</label>
                        <div class="Field">
                            <input type="text" id="User" name="User" value="[% Data.User | html %]" class="W75pc Validate_Required [% Data.UserInvalid | html %]" maxlength="200"/>
                            <div id="UserServerError" class="TooltipErrorMessage"><p>[% Translate("This field is required.") | html %]</p></div>
                        </div><div class="Clear"></div>

                        <div id="OAuth2FunctionalAccountField" class="Row">
                            <label for="OAuth2FunctionalAccount" class="Mandatory"><span class="Marker">*</span>[% Translate("OAuth functional account") | html %]:</label>
                            <div class="Field">
                                [% Data.OAuth2FunctionalAccountSelect %]
                                <div id="OAuth2FunctionalAccountServerError" class="TooltipErrorMessage"><p>[% Translate("Please select a valid OAuth functional account.") | html %]</p></div>
                            </div><div class="Clear"></div>
                        </div>

                        <div id="AnonymousField" class="Row">
                            <label for="Anonymous">[% Translate("Anonymous SMTP") | html %]</label>
                            <div class="Field">
                                <input type="checkbox" id="Anonymous" name="Anonymous" value="1" [% Data.AnonymousChecked %]/>
                            </div><div class="Clear"></div>
                        </div>

                        <div id="PasswordField" class="Row">
                            <label for="PasswordDecrypted" id="PasswordLabel" class="Mandatory"><span id="PasswordMarker" class="Marker">*</span>[% Translate("Password") | html %]:</label>
                            <div class="Field">
                                <input type="password" id="PasswordDecrypted" name="PasswordDecrypted" value="" autocomplete="new-password" placeholder="[% Translate(Data.PasswordPlaceholder) | html %]" class="W75pc [% Data.PasswordRequired ? 'Validate_Required' : '' %] [% Data.PasswordInvalid | html %]" maxlength="250"/>
                                <div id="PasswordServerError" class="TooltipErrorMessage"><p>[% Translate("A password is required for this account.") | html %]</p></div>
                            </div><div class="Clear"></div>
                        </div>

                        <label for="Emails" class="Mandatory"><span class="Marker">*</span>[% Translate("Emails") | html %]:</label>
                        <div class="Field">
                            [% Data.EmailsSelect %]
                            <div id="EmailsServerError" class="TooltipErrorMessage"><p>[% Translate("Select at least one email address.") | html %]</p></div>
                        </div><div class="Clear"></div>

                        <label for="ValidID" class="Mandatory"><span class="Marker">*</span>[% Translate("Validity") | html %]:</label>
                        <div class="Field">[% Data.ValidSelect %]</div><div class="Clear"></div>

                        <label for="Comments">[% Translate("Comment") | html %]:</label>
                        <div class="Field"><input type="text" id="Comments" name="Comments" value="[% Data.Comments | html %]" class="W75pc" maxlength="250"/></div><div class="Clear"></div>

                        <div class="Field SpacingTop">
                            <button class="Primary CallForAction" type="submit"><span>[% Translate("Save") | html %]</span></button>
                            [% Translate("or") | html %]
                            <a href="[% Env("Baselink") %]Action=[% Env("Action") %]">[% Translate("Cancel") | html %]</a>
                        </div><div class="Clear"></div>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>
    <div class="Clear"></div>
</div>
[% WRAPPER JSOnDocumentComplete %]
<script type="text/javascript">
    function UpdateAuthFields() {
        var AuthMethod = $('#AuthMethod').val();
        var IsBasic = AuthMethod === 'Basic';
        var IsAnonymous = IsBasic && $('#Anonymous').is(':checked');
        var OriginalAuthMethod = $('#AuthMethod').data('original-auth-method');
        var HasPassword = $('#AuthMethod').data('has-password');
        var PasswordRequired = IsBasic && !IsAnonymous && (OriginalAuthMethod !== 'Basic' || !HasPassword);

        if (!IsBasic) {
            $('#Anonymous').prop('checked', false);
        }
        $('#AnonymousField').toggle(IsBasic);
        $('#OAuth2FunctionalAccountField').toggle(!IsBasic);
        $('#User').toggleClass('Validate_Required', !IsAnonymous);
        $('#UserLabel').toggleClass('Mandatory', !IsAnonymous);
        $('#UserMarker').toggleClass('Marker', !IsAnonymous).text(IsAnonymous ? '' : '*');
        $('#PasswordField').toggle(IsBasic && !IsAnonymous);
        $('#PasswordDecrypted').toggleClass('Validate_Required', PasswordRequired);
        $('#PasswordLabel').toggleClass('Mandatory', PasswordRequired);
        $('#PasswordMarker').toggleClass('Marker', PasswordRequired).text(PasswordRequired ? '*' : '');
        $('#OAuth2FunctionalAccount').toggleClass('Validate_Required', !IsBasic);

        if (IsAnonymous) {
            $('#User').val('');
            $('#PasswordDecrypted').val('');
        }
    }

    $('#AuthMethod').data('original-auth-method', '[% (Data.OriginalAuthMethod || "Basic") | html %]');
    $('#AuthMethod').data('has-password', [% Data.PasswordPresent ? 'true' : 'false' %]);
    $('#AuthMethod').on('change', UpdateAuthFields);
    $('#Anonymous').on('change', UpdateAuthFields);
    UpdateAuthFields();
</script>
[% END %]
